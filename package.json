{
  "name": "femaction-bot",
  "version": "1.0.0",
  "description": "Discord бот с РП-командами (слеш-команды)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "tsx src/lib/deployCommands.ts",
    "deploy:prod": "node dist/lib/deployCommands.js",
    "clear:guild": "tsx src/lib/clearGuildCommands.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
