{
  "name": "femaction-bot",
  "version": "1.0.0",
  "description": "Discord бот с РП-командами (текстовые + слеш команды)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "tsx src/lib/deployCommands.ts",
    "deploy:prod": "node dist/lib/deployCommands.js"
  },
  "dependencies": {
    "discord.js": "14.26.4"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "tsx": "4.22.3",
    "typescript": "5.7.2"
  }
}
