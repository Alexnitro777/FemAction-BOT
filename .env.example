# Токен бота из Discord Developer Portal (Bot -> Token)
DISCORD_TOKEN=

# Application ID (General Information -> Application ID)
CLIENT_ID=

# ID тестового сервера для мгновенной регистрации слеш-команд при разработке.
# Оставь пустым для глобальной регистрации (обновляется до часа).
GUILD_ID=

# Префикс для текстовых команд
PREFIX=!
